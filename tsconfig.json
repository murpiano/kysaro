{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,

    "allowJs": true,
    "checkJs": false,

    "types": ["jest", "node"]
  },
  "include": ["src", "**/*.ts"]
}
