{
  "$schema": "./commit.schema.json",
  "header": {
    "minLength": 20,
    "maxLength": 72,
    "emoji": {
      "use": "required",
      "spaceAfter": "required",
      "index": 0
    },
    "type": {
      "use": "required",
      "case": "lower",
      "spaceAfter": "required",
      "index": 1
    },
    "scope": {
      "use": "required",
      "case": "lower",
      "spaceAfter": "required",
      "index": 2
    },
    "colon": {
      "use": "required",
      "spaceAfter": "required",
      "index": 3
    },
    "subject": {
      "use": "required",
      "case": "lower",
      "spaceAfter": "forbidden",
      "index": 4
    },
    "endSymbol": {
      "use": "forbidden",
      "typeSymbol": "."
    }
  },
  "body": {
    "required": true,
    "minLength": 20,
    "maxLength": 200,
    "eachItem": {
      "maxLength": 100,
      "startDash": {
        "use": "required",
        "spaceAfter": "required",
        "index": 0
      },
      "emoji": {
        "use": "required",
        "matchHeader": "required",
        "spaceAfter": "required",
        "index": 1
      },
      "type": {
        "use": "forbidden",
        "case": "lower",
        "spaceAfter": "required",
        "matchHeader": "required",
        "index": 1
      },
      "scope": {
        "use": "forbidden",
        "case": "lower",
        "spaceAfter": "required",
        "matchHeader": "required",
        "index": 1
      },
      "colon": {
        "use": "forbidden",
        "spaceAfter": "required",
        "index": 3
      },
      "text": {
        "use": "required",
        "case": "lower",
        "spaceAfter": "forbidden",
        "index": 1
      },
      "endSymbol": {
        "use": "required",
        "typeSymbol": "."
      }
    }
  }
}
